---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import { appStoreURL } from '../site';

const apple = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.64c-.02-2.3 1.88-3.4 1.96-3.45-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.15-2.76.83-3.48.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.79-.41 6.92 1.16 9.19.77 1.11 1.68 2.36 2.87 2.31 1.15-.05 1.59-.75 2.98-.75 1.39 0 1.78.75 3 .72 1.24-.02 2.02-1.13 2.78-2.24.88-1.29 1.24-2.54 1.26-2.6-.03-.01-2.41-.93-2.42-3.71zM14.1 5.9c.63-.77 1.06-1.83.94-2.9-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.05-.52 2.69-1.27z" /></svg>';

// KeyBar.swift: the fixed keys in order, then the default extras from KeyBarKeys.swift.
const keys = [
  { k: 'esc', does: 'esc stops Claude mid-answer.' },
  { k: 'ctrl', does: 'ctrl turns the next key into a control key, so ctrl then c is ^C.' },
  { k: '⇥', does: 'Tab completes a path or a command.' },
  { k: '⇤', does: 'Shift-Tab cycles Claude Code’s modes: default, accept edits and plan.' },
  { k: '←', does: 'The arrows move through menus, history and the prompt.' },
  { k: '↑', does: 'The arrows move through menus, history and the prompt.' },
  { k: '↓', does: 'The arrows move through menus, history and the prompt.' },
  { k: '→', does: 'The arrows move through menus, history and the prompt.' },
  ...['|', '~', '/', '-', '`', '$', '&', '*', '\\'].map((k) => ({ k, does: `${k} types itself. Choose and order up to 16 of these in Settings.` })),
];

const features = [
  { t: 'Buttons for prompts', d: 'When Claude Code shows a numbered menu, such as a permission prompt, Kessik shows one button for each option.' },
  { t: 'Every Mac you have', d: 'Save several Macs, give each one a name and switch between them with one tap.' },
  { t: 'Replies and snippets', d: 'One-tap replies sit above the terminal. Saved commands wait in the Sessions tab. Export and import them as JSON.' },
  { t: 'Photos and ports', d: 'Send a photo to the Mac for a Claude prompt. Preview a dev server port from the Mac in Safari inside the app.' },
  { t: 'Your colors, your font', d: 'Six terminal themes, or import an iTerm2 .itermcolors file. Four bundled mono fonts, or add your own.' },
  { t: 'Home or away', d: 'Find Macs on your Wi-Fi with Bonjour. Away from home, connect through Tailscale on any network.' },
];
---
<Base>
  <section class="hero wrap">
    <div class="copy rise">
      <div class="eyebrow green"><span class="live"></span>ssh → tmux → claude</div>
      <h1 class="display">Claude Code on your Mac, from your iPhone<span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">Kessik opens Claude Code on your Mac over SSH. Every session starts inside tmux, so it keeps running when your phone locks, loses signal or closes the app. Come back later and carry on.</p>
      <div class="actions">
        <a class="btn primary large" href={appStoreURL}>
          <Fragment set:html={apple} />
          <span class="stack"><small>Download on the</small>App Store</span>
        </a>
        <a class="btn large" href="#setup">What the Mac needs</a>
      </div>
      <p class="fine faint">iPhone with iOS 17 or later. No server, no account, nothing collected.</p>
    </div>
    <div class="hero-demo rise" style="--d: .12s"><Phone /></div>
  </section>

  <section class="wrap band" id="tmux">
    <div class="head" data-reveal>
      <div class="eyebrow coral">tmux, on by default</div>
      <h2 class="display">Lock the phone. The work goes on.</h2>
      <p class="lede">The phone only watches. Claude runs in a tmux session on the Mac, so a locked screen, a dead zone or a closed app changes nothing. Pick the same folder again and Kessik attaches to the session that is already there.</p>
    </div>
    <div class="timeline card" data-reveal style="--d: .1s" aria-label="A timeline: the iPhone connects, locks and reconnects while tmux on the Mac runs the whole time" role="img">
      <div class="lane">
        <span class="who">iPhone</span>
        <span class="track"><i class="seg on"></i><i class="seg off"></i><i class="seg on"></i></span>
      </div>
      <div class="lane">
        <span class="who">Mac · tmux</span>
        <span class="track"><i class="seg run"></i></span>
      </div>
      <div class="marks"><span>9:41 you ask</span><span>9:43 phone locks</span><span>10:12 back</span></div>
      <div class="sweep"><i></i></div>
    </div>
  </section>

  <section class="wrap band split" id="keys">
    <div class="head" data-reveal>
      <div class="eyebrow coral">The key bar</div>
      <h2 class="display">The keys a phone forgot.</h2>
      <p class="lede">esc, ctrl, Tab, Shift-Tab and the arrows sit above the keyboard, with the shell symbols you pick. Swipe to scroll history. Pinch to resize text.</p>
    </div>
    <div class="keybar card" data-reveal style="--d: .1s" data-keybar>
      <div class="row" role="group" aria-label="Key bar">
        {keys.map((x, i) => <button type="button" class="key" data-does={x.does} aria-pressed={i === 3 ? 'true' : 'false'}>{x.k}</button>)}
      </div>
      <p class="readout" data-readout aria-live="polite">{keys[3].does}</p>
    </div>
  </section>

  <section class="wrap band">
    <div class="grid">
      {features.map((f, i) => (
        <div class="feature card" data-reveal style={`--d: ${(i % 3) * 0.07}s`}>
          <h3 class="display"><span class="hot">›</span> {f.t}</h3>
          <p>{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap band split" id="setup">
    <div class="head" data-reveal>
      <div class="eyebrow coral">Setup</div>
      <h2 class="display">Three things on the Mac.</h2>
      <p class="lede">Four guides in the app walk through each step. Tailscale is optional.</p>
    </div>
    <ol class="steps card" data-reveal style="--d: .1s">
      <li><span class="n">1</span><div><b>Turn on Remote Login</b><p>System Settings › General › Sharing › Remote Login.</p></div></li>
      <li><span class="n">2</span><div><b>Install tmux</b><button type="button" class="cmd" data-copy="brew install tmux"><span>brew install tmux</span><em>copy</em></button></div></li>
      <li><span class="n">3</span><div><b>Sign in to Claude Code once</b><button type="button" class="cmd" data-copy="claude"><span>claude</span><em>copy</em></button></div></li>
    </ol>
  </section>

  <section class="wrap band twin">
    <div class="card panel" data-reveal>
      <div class="eyebrow green">Privacy</div>
      <h2 class="display">No server. Nothing collected.</h2>
      <p>Kessik has no server of its own, no account and no analytics. It connects only to the Macs you choose, over SSH.</p>
      <a class="btn" href="/privacy/">Read the privacy policy</a>
    </div>
    <div class="card panel" data-reveal style="--d: .1s">
      <div class="eyebrow green">Security</div>
      <h2 class="display">Your keys stay on the phone.</h2>
      <p>Make an ed25519 key in the app or use a password. Both live in the iPhone Keychain, and Face ID can guard them before each login. If a Mac's host key changes, Kessik stops.</p>
      <a class="btn" href="/support/">Support</a>
    </div>
  </section>

  <section class="wrap band">
    <div class="cta card" data-reveal>
      <img class="icon" src="/apple-touch-icon.png" width="96" height="96" loading="lazy" decoding="async" alt="The Kessik app icon: a glowing coral prompt on black" />
      <div>
        <h2 class="display">Start it at your desk. Finish it anywhere.</h2>
        <p class="lede">Kessik is on the App Store for iPhone.</p>
        <div class="actions"><a class="btn primary large" href={appStoreURL}><Fragment set:html={apple} /><span class="stack"><small>Download on the</small>App Store</span></a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; padding: clamp(28px, 6vh, 72px) 0 clamp(40px, 8vh, 96px); min-height: min(calc(100svh - 64px), 820px); }
  .hero > *, .split > * { min-width: 0; }
  .hero h1 { margin-top: 16px; }
  .hero .lede { margin-top: 22px; }
  .live { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); vertical-align: 1px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .fine { font-size: 13px; margin-top: 18px; }
  .hero-demo { perspective: 1600px; }
  .hero-demo :global(.phone) { transform: rotateY(-8deg) rotateX(2deg); }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero-demo :global(.phone) { transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor { animation: blink 1.05s steps(1) infinite; }
    .live { animation: pulse 1.6s ease-in-out infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    @keyframes pulse { 50% { opacity: 0.35; } }
  }

  .band { padding-top: clamp(64px, 11vh, 120px); scroll-margin-top: 64px; }
  .head h2 { margin-top: 12px; }
  .head .lede { margin-top: 16px; font-size: 17px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 72px); align-items: center; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }

  /* tmux timeline: the phone's lane breaks, the Mac's never does, and a playhead sweeps both. */
  .timeline { position: relative; margin-top: 36px; padding: 26px 24px 18px; overflow: hidden; }
  .lane { display: grid; grid-template-columns: 96px 1fr; align-items: center; gap: 16px; height: 34px; }
  .who { font: 500 12px/1 var(--mono); color: var(--muted); }
  .track { display: flex; gap: 4px; height: 10px; }
  .seg { display: block; height: 100%; border-radius: 5px; }
  .seg.on { flex: 1; background: var(--coral); box-shadow: var(--glow); }
  .seg.off { flex: 1.6; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.18) 0 6px, transparent 6px 12px); }
  .seg.run { flex: 1; background: var(--green); box-shadow: 0 0 14px rgba(61, 219, 133, 0.5); }
  .marks { display: flex; gap: 4px; margin: 14px 0 0 112px; font: 500 11.5px/1.3 var(--mono); color: var(--faint); }
  .marks span { flex: 1; }
  .marks span:nth-child(2) { flex: 1.6; }
  /* The playhead: a box over the tracks, and a line inside it that slides its own width. */
  .sweep { position: absolute; top: 18px; bottom: 44px; left: 136px; right: 24px; pointer-events: none; }
  .sweep i { position: absolute; inset: 0; border-left: 2px solid var(--fg); opacity: 0.85; }
  @media (prefers-reduced-motion: no-preference) {
    .in .sweep i { animation: sweep 8s linear infinite; }
    @keyframes sweep { from { transform: translateX(0); } to { transform: translateX(100%); } }
  }
  @media (max-width: 640px) {
    .timeline { padding-inline: 16px; }
    .lane { grid-template-columns: 64px 1fr; gap: 12px; }
    .marks { margin-left: 76px; font-size: 10px; }
    .sweep { left: 92px; right: 16px; }
  }

  /* Key bar */
  .keybar { padding: 22px; }
  .row { display: flex; flex-wrap: wrap; gap: 6px; }
  .key { min-width: 40px; height: 40px; padding: 0 10px; border-radius: 9px; border: 1px solid transparent; background: #26262b; color: var(--fg); font: 500 15px/1 var(--mono); cursor: pointer; transition: transform 0.12s var(--ease), background 0.2s, border-color 0.2s, box-shadow 0.2s; }
  .key:hover { background: #303036; }
  .key:active { transform: scale(0.93); }
  .key[aria-pressed='true'] { border-color: var(--coral); box-shadow: var(--glow); color: #fff; }
  .readout { margin-top: 18px; min-height: 3em; font: 500 13.5px/1.5 var(--mono); color: var(--muted); }
  .readout::before { content: '› '; color: var(--coral); }

  /* Features */
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  /* Keeps the reveal's fade and stagger, which a bare `transition` here would override. */
  .feature { padding: 22px 22px 24px; transition: opacity 0.7s var(--ease) var(--d, 0s), transform 0.7s var(--ease) var(--d, 0s), border-color 0.2s var(--ease); }
  .feature:hover { border-color: var(--edge-strong); }
  .feature p { margin-top: 10px; color: var(--muted); font-size: 15px; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }

  /* Setup */
  .steps { list-style: none; margin: 0; padding: 8px 22px; }
  .steps li { display: flex; gap: 16px; padding: 18px 0; }
  .steps li + li { border-top: 1px solid var(--edge); }
  .steps .n { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--coral); color: var(--ground); font: 700 13px/1 var(--mono); }
  .steps b { display: block; font-weight: 600; }
  .steps p { margin-top: 4px; color: var(--muted); font-size: 15px; }
  .steps li > div { min-width: 0; flex: 1; }
  .cmd { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; margin-top: 8px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--edge); background: rgba(0, 0, 0, 0.35); color: var(--fg); font: 500 14px/1 var(--mono); cursor: pointer; text-align: left; }
  .cmd span::before { content: '$ '; color: var(--faint); }
  .cmd em { font: 600 11px/1 var(--mono); font-style: normal; color: var(--faint); letter-spacing: 0.04em; transition: color 0.2s; }
  .cmd:hover { border-color: var(--edge-strong); }
  .cmd:hover em, .cmd.done em { color: var(--green); }

  /* Privacy and security */
  .twin { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .panel { padding: 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .panel h2 { font-size: clamp(24px, 2.6vw, 30px); }
  .panel p { color: var(--muted); font-size: 15.5px; }
  .panel .btn { margin-top: auto; }
  @media (max-width: 760px) { .twin { grid-template-columns: 1fr; } }

  /* Download */
  .cta { display: flex; align-items: center; gap: 28px; padding: 34px 36px; background-image: radial-gradient(ellipse 60% 120% at 0% 100%, rgba(255, 97, 92, 0.16), transparent 60%); }
  .cta .lede { margin-top: 10px; }
  .cta .actions { margin-top: 20px; }
  .icon { width: 96px; height: 96px; border-radius: 22%; flex: none; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 60px rgba(255, 97, 92, 0.3); }
  @media (max-width: 640px) { .cta { flex-direction: column; align-items: flex-start; padding: 26px 22px; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-keybar]');
  const readout = bar?.querySelector<HTMLElement>('[data-readout]');
  bar?.querySelectorAll<HTMLButtonElement>('.key').forEach((key, _, all) => {
    key.addEventListener('click', () => {
      all.forEach((k) => k.setAttribute('aria-pressed', String(k === key)));
      readout!.textContent = key.dataset.does!;
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.querySelector('em')!;
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); label.textContent = 'copied'; }
      catch { label.textContent = 'select it'; }
      b.classList.add('done');
      setTimeout(() => { b.classList.remove('done'); label.textContent = 'copy'; }, 1600);
    });
  });
</script>
