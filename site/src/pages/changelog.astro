---
import Base from '../layouts/Base.astro';
import { email } from '../site';
import notes from '../../../release-notes.json';

// The same release-notes.json the app bundles and reads through Kessik/Models/ReleaseNotes.swift.
// It is imported here, not copied, so a version written for the app is on the site the next time
// the site deploys. This page only renders the file.
type Kind = 'new' | 'better' | 'fixed';

interface Change {
  kind: Kind;
  title: string;
  detail: string;
}

interface Release {
  version: string;
  date: string;
  headline: string;
  lead: string;
  changes: Change[];
}

const releases = notes.versions as Release[];

const kindLabel: Record<Kind, string> = { new: 'New', better: 'Better', fixed: 'Fixed' };

// "16 October 2026". UTC, because the file's dates are days and a timezone would slide some of them.
const day = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---
<Base title="Changelog" description="What changed in each version of Kessik, the iPhone app that opens Claude Code on your Mac over SSH. Newest first.">
  <section class="wrap page">
    <header class="head rise">
      <div class="eyebrow coral">Changelog</div>
      <h1 class="display">What changed.</h1>
      <p class="lede">Each version of Kessik, newest first.</p>
    </header>

    <div class="releases">
      {releases.map((release, index) => (
        <article class="release" data-reveal style={`--d: ${index * 0.05}s`}>
          <div class="stamp">
            <h2 class="number">{release.version}</h2>
            <time datetime={release.date}>{day(release.date)}</time>
          </div>

          <div class="body card">
            <h3 class="headline display">{release.headline}</h3>
            <p class="intro">{release.lead}</p>
            <ul class="changes">
              {release.changes.map((change) => (
                <li class="change">
                  <span class={`chip ${change.kind}`}>{kindLabel[change.kind]}</span>
                  <h4 class="what">{change.title}</h4>
                  <p class="means">{change.detail}</p>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <p class="tail" data-reveal>
      The same notes are in the app, under Settings, Changelog. Both read one file, so neither is
      ahead of the other. Anything missing: <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </section>
</Base>

<style>
  .page { max-width: 760px; }
  .head h1 { margin-top: 12px; }
  .head .lede { margin-top: 16px; }

  .releases { display: grid; gap: 40px; margin-top: 36px; }

  .stamp { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .number { font: 600 22px/1 var(--mono); letter-spacing: -0.03em; color: var(--fg); margin: 0; }
  .number::before { content: 'v'; color: var(--coral); }
  time { color: var(--faint); font-size: 13.5px; }

  .body { margin-top: 12px; padding: 24px 26px; }
  .headline { font-size: 22px; line-height: 1.2; letter-spacing: -0.03em; }
  .intro { color: var(--muted); font-size: 15.5px; line-height: 1.6; margin-top: 10px; max-width: 58ch; }

  .changes { list-style: none; margin: 22px 0 0; padding: 0; }
  .change { padding: 16px 0; border-top: 1px solid var(--edge); }
  .change:first-child { border-top-color: var(--edge-strong); }
  .change:last-child { padding-bottom: 2px; }

  .chip {
    display: inline-flex; align-items: center; height: 20px; padding: 0 8px;
    border-radius: 999px; border: 1px solid var(--edge);
    font: 600 10.5px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
  }
  .chip.new { color: var(--green); border-color: rgba(61, 219, 133, 0.4); }
  .chip.better { color: var(--amber); border-color: rgba(255, 194, 71, 0.4); }
  .chip.fixed { color: var(--coral); border-color: rgba(255, 97, 92, 0.4); }

  .what { font: 600 16px/1.3 var(--mono); letter-spacing: -0.02em; color: var(--fg); margin: 10px 0 0; }
  .means { color: var(--muted); font-size: 15px; line-height: 1.6; margin-top: 6px; max-width: 60ch; }

  .tail { color: var(--faint); font-size: 14px; line-height: 1.65; margin-top: 40px; max-width: 62ch; }

  @media (max-width: 520px) {
    .body { padding: 18px; }
  }
</style>
