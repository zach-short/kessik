---
import '../styles/global.css';
import { appStoreURL, email } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** For the 404 page: no canonical URL, and kept out of search results. */
  noindex?: boolean;
}
const {
  title,
  noindex = false,
  description = 'Kessik opens Claude Code on your Mac from your iPhone over SSH. Sessions run in tmux and keep going when your phone locks.',
} = Astro.props;
const fullTitle = title ? `${title} · Kessik` : 'Kessik: Claude Code on your Mac, from your iPhone';
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0C0C0E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kessik" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/icon.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="wall" aria-hidden="true"></div>
    <header class="nav">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Kessik home">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 9l7.5 7L7 23" /><path d="M17.5 23H25" /></svg>
          Kessik
        </a>
        <nav aria-label="Site">
          <a href="/support/" aria-current={path === '/support' ? 'page' : undefined}>Support</a>
          <a class="hide-sm" href="/privacy/" aria-current={path === '/privacy' ? 'page' : undefined}>Privacy</a>
          <a class="btn primary" href={appStoreURL}>Get the app</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap inner">
        <div>
          <a class="brand" href="/">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 9l7.5 7L7 23" /><path d="M17.5 23H25" /></svg>
            Kessik
          </a>
          <p class="line">An SSH client for Claude Code. No server, no account, nothing collected.</p>
          <p class="line faint">&copy; 2026 Zach Short</p>
        </div>
        <nav class="cols" aria-label="Footer">
          <a href="/support/">Support</a>
          <a href="/privacy/">Privacy policy</a>
          <a href="/terms/">Terms of use</a>
          <a href={`mailto:${email}`}>{email}</a>
        </nav>
      </div>
    </footer>
    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = 'IntersectionObserver' in window && new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io && io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      items.forEach((el) => (io ? io.observe(el) : el.classList.add('in')));
    </script>
  </body>
</html>

<style>
  .nav { position: sticky; top: 0; z-index: 20; padding: 12px 0; }
  .nav::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(rgba(12, 12, 14, 0.85), rgba(12, 12, 14, 0));
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    -webkit-mask: linear-gradient(#000 55%, transparent); mask: linear-gradient(#000 55%, transparent);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--fg); font: 600 17px/1 var(--mono); letter-spacing: -0.03em; }
  .brand:hover { text-decoration: none; }
  .brand svg { width: 24px; height: 24px; fill: none; stroke: var(--coral); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 5px rgba(255, 97, 92, 0.7)); }
  .bar nav { display: flex; align-items: center; gap: 6px; }
  .bar nav a:not(.btn) { color: var(--muted); font-size: 14px; font-weight: 500; padding: 8px 12px; border-radius: 10px; transition: color 0.2s, background 0.2s; }
  .bar nav a:not(.btn):hover, .bar nav a[aria-current='page'] { color: var(--fg); background: rgba(255, 255, 255, 0.06); text-decoration: none; }
  .bar nav .btn { min-height: 36px; padding: 0 14px; font-size: 13.5px; margin-left: 6px; }
  @media (max-width: 420px) { .hide-sm { display: none; } }
  @media (max-width: 360px) { .bar nav a:not(.btn) { display: none; } }

  .foot { margin-top: 112px; padding: 40px 0 48px; border-top: 1px solid var(--edge); }
  .inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .line { color: var(--muted); font-size: 13.5px; margin-top: 12px; max-width: 44ch; }
  .line.faint { color: var(--faint); margin-top: 4px; }
  .cols { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .cols a { color: var(--muted); font-size: 14px; }
  .cols a:hover { color: var(--fg); }
</style>
